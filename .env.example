# =============================================================================
# Ads Analytics Dashboard — environment variables (TEMPLATE)
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Secrets are marked [SECRET]. Non-secret config shows a sensible default.
# Variables are grouped by the phase that introduces them.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — PostgreSQL (Phase 2)
# -----------------------------------------------------------------------------
# [SECRET] Full Postgres connection string used by Prisma.
# Dev example: postgresql://user:password@localhost:5432/adsdashboard?schema=public
DATABASE_URL=

# -----------------------------------------------------------------------------
# Authentication — Auth.js / NextAuth (Phase 2)
# -----------------------------------------------------------------------------
# [SECRET] Random 32+ byte string. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Canonical URL of the app (dev: http://localhost:3000, prod: https://ads.bluekarmasecrets.com)
AUTH_URL=http://localhost:3000
# Allow public self-registration. Keep "false" for an internal tool: the FIRST
# account to register bootstraps as ADMIN regardless. Set "true" only if anyone
# with the URL should be able to sign themselves up.
ALLOW_PUBLIC_REGISTRATION=false

# -----------------------------------------------------------------------------
# Token encryption at rest (Phase 2)
# -----------------------------------------------------------------------------
# [SECRET] 32-byte key (hex or base64) used to encrypt platform tokens before
# they are stored in the database. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Google Ads API (Phase 3)
# -----------------------------------------------------------------------------
# [SECRET] Developer token from Google Ads API Center (Explorer Access to start).
GOOGLE_DEVELOPER_TOKEN=
# [SECRET] OAuth2 client credentials (Google Cloud Console → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# [SECRET] Long-lived refresh token captured via the one-time OAuth consent flow.
GOOGLE_REFRESH_TOKEN=
# Optional: manager (MCC) account id used as login-customer-id, digits only (no dashes).
GOOGLE_LOGIN_CUSTOMER_ID=
# Redirect URI registered in Google Cloud for the OAuth consent flow.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# -----------------------------------------------------------------------------
# Meta (Facebook / Instagram) Marketing API (Phase 4)
# -----------------------------------------------------------------------------
# [SECRET] System User token (scopes: ads_read, read_insights), set to never expire.
META_SYSTEM_USER_TOKEN=
# App identifiers from developers.facebook.com.
META_APP_ID=
# [SECRET] Only needed if you later verify webhooks / appsecret_proof.
META_APP_SECRET=
# Graph API version to call.
META_GRAPH_API_VERSION=v25.0
# Which Meta action_type values count as a conversion (comma-separated).
# Defaults to "purchase,lead" if unset.
META_CONVERSION_ACTIONS=

# -----------------------------------------------------------------------------
# Sync engine (Phase 5)
# -----------------------------------------------------------------------------
# Reporting timezone kept consistent across sync + queries (Bali = UTC+8).
SYNC_TIMEZONE=Asia/Makassar
# How many trailing days each scheduled run re-pulls (upsert corrects late data).
SYNC_ROLLING_DAYS=21
# Toggle the in-process scheduler (set to "false" if you drive syncs via host cron).
CRON_ENABLED=true
# Cron expression for the daily sync (default 02:30 in SYNC_TIMEZONE).
SYNC_CRON=30 2 * * *

# -----------------------------------------------------------------------------
# Monitoring & alerts (Phase 8) — optional, wire up later
# -----------------------------------------------------------------------------
# Webhook (Slack/WhatsApp/etc.) that receives daily sync summaries + failure alerts.
ALERT_WEBHOOK_URL=
# Error tracking DSN (e.g. Sentry). Leave blank to disable.
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Email — scheduled reports & revenue reminders (Phase 14)
# -----------------------------------------------------------------------------
# SMTP transport used to send scheduled report emails and revenue reminders.
# On cPanel, create a mailbox (e.g. reports@bluekarmasecrets.com) and use its
# outgoing SMTP settings. When these are unset, schedules still save but sends
# are a logged no-op (the Reports page shows a warning).
SMTP_HOST=
# 465 = implicit TLS, 587/25 = STARTTLS.
SMTP_PORT=587
# Mailbox login (usually the full email address).
SMTP_USER=
# [SECRET] Mailbox password / app password.
SMTP_PASS=
# From address on outgoing mail (defaults to SMTP_USER if unset).
MAIL_FROM=reports@bluekarmasecrets.com
# Base URL used for the "Open dashboard" / "Enter revenue" links in emails.
# Falls back to AUTH_URL, then https://ads.bluekarmasecrets.com.
APP_URL=https://ads.bluekarmasecrets.com

# -----------------------------------------------------------------------------
# AI insights (Phase 9) — Groq
# -----------------------------------------------------------------------------
# [SECRET] Groq API key (starts with gsk_). Free key: https://console.groq.com/keys
# Server-side only — it must NEVER be exposed to the browser.
GROQ_API_KEY=
# Model to use. Groq's lineup changes often, so this is configurable, not
# hardcoded. Fast/cheap default; use openai/gpt-oss-120b for higher quality.
GROQ_MODEL=openai/gpt-oss-20b
# Vision-capable model for reading revenue screenshots (image uploads). Also
# configurable since Groq's vision lineup changes.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
