// Ads Analytics Dashboard — Prisma schema (Phase 2)
// Prisma 7: the datasource URL is supplied by prisma.config.ts (from .env),
// not inline here. The generated client is emitted to src/generated/prisma.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

// Lowercase values match the domain strings used across the API/connectors
// (platform="google" / "meta").
enum Platform {
  google
  meta
}

/// A property is either a hotel (top-level) or an outlet under a hotel.
enum PropertyKind {
  hotel
  restaurant
  spa
}

enum ConnectionStatus {
  active
  needs_reauth
  error
}

enum SyncStatus {
  running
  success
  error
}

/// Whether a campaign is shown on the owner report. New campaigns start
/// `pending` (excluded until reviewed); `included` shows on the report.
enum CampaignReportStatus {
  pending
  included
  excluded
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// Business units whose ad performance we track. Hotels are top-level
/// (`parentId` null, `kind` = hotel); restaurant/spa outlets hang under a hotel
/// via `parentId` and are reported separately, never blended into hotel totals.
model Property {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  kind      PropertyKind @default(hotel)
  parentId  String? // set for outlets; null for top-level hotels
  active    Boolean      @default(true) // hidden from the dashboard when false
  createdAt DateTime     @default(now())

  parent  Property?  @relation("PropertyOutlets", fields: [parentId], references: [id], onDelete: Cascade)
  outlets Property[] @relation("PropertyOutlets")

  adAccounts     AdAccount[]
  metricsDaily   MetricsDaily[]
  campaignRoutes CampaignRoute[]
  revenue        RevenueMonthly[]
  campaigns      Campaign[]

  @@index([parentId])
  @@map("properties")
}

/// Dashboard logins for the team.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  @@map("users")
}

/// One row per connected platform account. The token is stored ENCRYPTED
/// (AES-256-GCM) in `secretEncrypted` — never in plain text.
model PlatformConnection {
  id              String           @id @default(cuid())
  platform        Platform
  accountRef      String // human-readable label / external account reference
  secretEncrypted String // AES-GCM ciphertext of the refresh/system token
  status          ConnectionStatus @default(active)
  lastSyncedAt    DateTime?
  createdAt       DateTime         @default(now())

  @@unique([platform, accountRef])
  @@map("platform_connections")
}

/// Links a platform ad-account id to a property, with its reporting currency.
model AdAccount {
  id                String   @id @default(cuid())
  propertyId        String
  platform          Platform
  externalAccountId String // Google customer id or Meta act_ id
  accountName       String
  currency          String   @db.Char(3) // ISO 4217, e.g. "IDR"

  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  metricsDaily   MetricsDaily[]
  campaignRoutes CampaignRoute[]
  campaigns      Campaign[]

  @@unique([platform, externalAccountId])
  @@index([propertyId])
  @@map("ad_accounts")
}

/// Routes campaigns within a shared ad account to different properties by
/// matching the campaign name (case-insensitive substring, or a regex).
/// Unmatched campaigns fall back to the ad account's own propertyId — so one
/// ad account can feed several properties, split by campaign.
model CampaignRoute {
  id          String   @id @default(cuid())
  adAccountId String
  pattern     String // matched against the campaign name
  isRegex     Boolean  @default(false)
  propertyId  String
  priority    Int      @default(0) // higher wins when multiple patterns match
  createdAt   DateTime @default(now())

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  property  Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([adAccountId])
  @@map("campaign_routes")
}

/// THE unified daily metrics table — both Google and Meta normalize into this.
/// Derived metrics (CTR/CPC/CPM/CVR/ROAS) are computed on read, never stored.
model MetricsDaily {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  propertyId      String
  platform        Platform
  adAccountId     String
  campaignId      String
  campaignName    String
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  spend           Decimal  @default(0) @db.Decimal(18, 4) // money — Decimal, never Float
  conversions     Decimal  @default(0) @db.Decimal(14, 4)
  conversionValue Decimal  @default(0) @db.Decimal(18, 4)
  currency        String   @db.Char(3)
  updatedAt       DateTime @updatedAt

  property  Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  // Idempotency: without this unique key, every daily re-sync would duplicate
  // rows. Connectors upsert on it, so re-pulling a date range corrects data.
  @@unique([date, platform, adAccountId, campaignId])
  @@index([date])
  @@index([propertyId])
  @@index([platform])
  @@index([propertyId, date])
  @@map("metrics_daily")
}

/// Cache + history of AI-generated insight summaries (Phase 9).
/// The AI only phrases pre-computed numbers — `inputSnapshot` stores exactly
/// what was sent to the model, so every summary stays auditable against the
/// figures behind it. `filtersHash` folds in a signature of the underlying data
/// so a cached summary is served only while the view AND its data are unchanged.
model AiSummary {
  id            String   @id @default(cuid())
  filtersHash   String // hash of (from,to,property,platform,language,dataSignature)
  periodFrom    DateTime @db.Date
  periodTo      DateTime @db.Date
  property      String   @default("all")
  platform      String   @default("all")
  language      String   @default("en")
  model         String
  summaryText   String
  inputSnapshot Json
  tokenUsage    Int      @default(0)
  generatedAt   DateTime @default(now())

  @@index([filtersHash])
  @@index([generatedAt])
  @@map("ai_summaries")
}

/// Monthly revenue per property, entered/uploaded by the team (not from the ad
/// platforms). Drives revenue-based ROAS (revenue ÷ ad spend). One row per
/// property per calendar month; upserted so a correction overwrites cleanly.
model RevenueMonthly {
  id         String   @id @default(cuid())
  propertyId String
  year       Int
  month      Int // 1–12
  amount     Decimal  @db.Decimal(18, 4) // money — Decimal, never Float
  currency   String   @db.Char(3) // ISO 4217, e.g. "IDR"
  source     String? // "manual" or "upload:<filename>"
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, year, month])
  @@index([propertyId])
  @@map("revenue_monthly")
}

/// Registry of every ad campaign we've seen, with whether it appears on the
/// owner report. Populated from metrics on each sync; new campaigns arrive as
/// `pending` so nothing reaches the report until it's reviewed and approved.
model Campaign {
  id          String               @id @default(cuid())
  platform    Platform
  adAccountId String
  externalId  String // platform campaign id (matches metrics_daily.campaignId)
  name        String
  propertyId  String?
  status      CampaignReportStatus @default(pending)
  locked      Boolean              @default(false) // manual property assignment; sync won't override it
  firstSeenAt DateTime             @default(now())
  lastSeenAt  DateTime             @updatedAt

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  property  Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@unique([platform, adAccountId, externalId])
  @@index([status])
  @@index([propertyId])
  @@map("campaigns")
}

/// Audit of every sync run (what ran, how many rows, success/error).
model SyncLog {
  id           String     @id @default(cuid())
  platform     Platform
  adAccountId  String?
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  status       SyncStatus @default(running)
  rowsWritten  Int        @default(0)
  errorMessage String?

  @@index([platform, startedAt])
  @@map("sync_logs")
}
